{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. Setup: create .venv, install packages, build C++ core",
            "type": "process",
            "command": "bash",
            "args": [
                "setup_mac_linux.sh"
            ],
            "windows": {
                "command": "cmd.exe",
                "args": [
                    "/d",
                    "/c",
                    "setup_windows.bat",
                    "--no-pause"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "2. Run analysis - demo (synthetic market)",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "fxquant",
                "analyze",
                "--source",
                "synthetic"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
            }
        },
        {
            "label": "3. Run analysis - live Yahoo data",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "fxquant",
                "analyze",
                "--source",
                "yahoo"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
            }
        },
        {
            "label": "4. Run analysis - CSV files in data/",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "fxquant",
                "analyze",
                "--source",
                "csv",
                "--csv-dir",
                "data"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
            }
        },
        {
            "label": "5. Run all tests",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "pytest",
                "-q",
                "tests"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
            }
        },
        {
            "label": "6. Benchmark C++ vs Python",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "fxquant",
                "bench"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONUTF8": "1"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "windows": {
                "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
            }
        },
        {
            "label": "7. Build and test the C++ core with CMake (optional)",
            "type": "shell",
            "command": "cmake -S . -B build && cmake --build build --config Release && ctest --test-dir build -C Release --output-on-failure",
            "windows": {
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "cmd.exe",
                        "args": [
                            "/d",
                            "/c"
                        ]
                    }
                }
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
